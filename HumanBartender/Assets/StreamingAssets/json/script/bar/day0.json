          "type": "say",
          "actor": "chris",
          "dialogue_id": "dlg_d1_tutorial_chris_049",
          "arg": "default",
          "text": {
            "ko": "좋아. 그럼 <order>진토닉</order> 한 잔 만들어 봐.",
            "en": "Good. Now — make me a <order>Gin & Tonic</order>."
          },
          "when": null,
          "effects": null,
          "sync": "wait"
        },
