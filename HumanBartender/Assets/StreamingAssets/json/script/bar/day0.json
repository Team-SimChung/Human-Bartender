          "dialogue_id": "dlg_d1_tutorial_wrap_016",
          "arg": "default",
          "text": {
            "ko": "이제 가게에서는 크리스 말고 보스라고 불러.",
            "en": "From now on, in the bar, it's not 'Chris' — call me 'Boss.'"
