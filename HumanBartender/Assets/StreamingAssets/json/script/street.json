    {
      "id": "d1_elevator",
      "steps": [
        {
          "type": "say",
          "actor": "radio",
          "dialogue_id": "dlg_d1_elevator_001",
          "arg": null,
          "text": {
            "ko": "…다음 뉴스입니다.",
            "en": "...In other news."
          },
          "when": null,
          "sync": "auto",
          "seq": 1
        },
        {
          "type": "say",
          "actor": "radio",
          "dialogue_id": "dlg_d1_elevator_002",
          "arg": null,
          "text": {
            "ko": "뉴런 트롤프 주니어가 대통령 8연임에 성공하며,\n신미합중국의 제67대 대통령으로 다시 한번 당선되었습니다.",
            "en": "Newron Trolph Jr. has won his eighth term,\nre-elected as the 67th President of the New United States."
          },
          "when": null,
          "sync": "auto",
          "seq": 2
        },
        {
          "type": "say",
          "actor": "radio",
          "dialogue_id": "dlg_d1_elevator_003",
          "arg": null,
          "text": {
            "ko": "트롤프 대통령은 당선 직후 연설에서",
            "en": "In his victory speech, President Trolph declared:"
          },
          "when": null,
          "sync": "auto",
          "seq": 3
        },
        {
          "type": "say",
          "actor": "radio",
          "dialogue_id": "dlg_d1_elevator_004",
          "arg": null,
          "text": {
            "ko": "\"위대한 국가 재건은 아직 끝나지 않았다.\"\n\"신미합중국은 다시 한 번 세계의 중심에 설 것이다.\"",
            "en": "\"The great national rebuilding is not over.\"\n\"The New United States will stand at the center of the world once more.\""
          },
          "when": null,
          "sync": "auto",
          "seq": 4
        },
        {
          "type": "say",
          "actor": "radio",
          "dialogue_id": "dlg_d1_elevator_005",
          "arg": null,
          "text": {
            "ko": "라고 밝혔습니다.",
            "en": "— he stated."
          },
          "when": null,
          "sync": "auto",
          "seq": 5
        }
      ]
    },
