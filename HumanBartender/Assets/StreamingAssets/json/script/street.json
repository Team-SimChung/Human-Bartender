        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_002",
          "arg": "idle",
          "text": {
            "ko": "뭘 봐? 시바.",
            "en": "What're you looking at? Shiba."
          },
          "when": null,
          "sync": "player_input",
          "seq": 2
        },
        {
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_003",
          "arg": "idle",
          "text": {
            "ko": "안녕하세요.",
            "en": "Hello."
          },
          "when": null,
          "sync": "player_input",
          "seq": 3
        },
        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_004",
          "arg": "idle",
          "text": {
            "ko": "하. 이 동네에서 인사하고\n돌아다니는 놈이 있네.",
            "en": "Ha. Someone in this neighborhood\nactually goes around greeting people."
          },
          "when": null,
          "sync": "player_input",
          "seq": 4
        },
        {
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_005",
          "arg": "idle",
          "text": {
            "ko": "혹시 인간입니까?",
            "en": "Are you, by any chance, human?"
          },
          "when": null,
          "sync": "player_input",
          "seq": 5
        },
        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_006",
          "arg": "idle",
          "text": {
            "ko": "뭐래, 너 머리 나쁘냐?",
            "en": "What? Are you slow or something?"
          },
          "when": null,
          "sync": "player_input",
          "seq": 6
        },
        {
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_007",
          "arg": "idle",
          "text": {
            "ko": "육안으로 봤을 때 강아지로 판단됩니다.",
            "en": "Visual assessment indicates: dog."
          },
          "when": null,
          "sync": "player_input",
          "seq": 7
        },
        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_008",
          "arg": "idle",
          "text": {
            "ko": "사람을 얼굴로 판단하지 말라고.\n못생긴 놈 같으니.",
            "en": "Don't judge people by their faces,\nyou ugly mug."
          },
          "when": null,
          "sync": "player_input",
          "seq": 8
        },
        {
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_009",
          "arg": "idle",
          "text": {
            "ko": "…그럼 사람이 맞는 건가요?",
            "en": "...So you ARE a person?"
          },
          "when": null,
          "sync": "player_input",
          "seq": 9
        },
        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_010",
          "arg": "idle",
          "text": {
            "ko": "아니?",
            "en": "Nope?"
          },
          "when": null,
          "sync": "player_input",
          "seq": 10
        },
        {
          "type": "say",
          "actor": "shiba",
          "dialogue_id": "dlg_np_shiba_1_011",
          "arg": "idle",
          "text": {
            "ko": "딱 보면 시바잖아, 시바.",
            "en": "One look and you can tell I'm a shiba, shiba."
          },
          "when": null,
          "sync": "player_input",
          "seq": 11
        },
        {
          "type": "say",
          "actor": "luna",
          "dialogue_id": "dlg_np_shiba_1_012",
          "arg": "idle",
          "text": {
            "ko": "아하… 확인했습니다.",
            "en": "I see... confirmed."
