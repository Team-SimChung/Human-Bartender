      Steps:
      - Seq: 1
        Type: say
        Actor: radio
        DialogueId: dlg_d1_elevator_001
        Arg: 
        Text:
          <Ko>k__BackingField: "\u2026\uB2E4\uC74C \uB274\uC2A4\uC785\uB2C8\uB2E4."
          <En>k__BackingField: ...In other news.
        When: 
        Effects: 
        Sync: wait
        SceneId: 
        Options: []
      - Seq: 2
        Type: say
        Actor: radio
        DialogueId: dlg_d1_elevator_002
        Arg: 
        Text:
          <Ko>k__BackingField: "\uB274\uB7F0 \uD2B8\uB864\uD504 \uC8FC\uB2C8\uC5B4\uAC00
            \uB300\uD1B5\uB839 8\uC5F0\uC784\uC5D0 \uC131\uACF5\uD558\uBA70,\n\uC2E0\uBBF8\uD569\uC911\uAD6D\uC758
            \uC81C67\uB300 \uB300\uD1B5\uB839\uC73C\uB85C \uB2E4\uC2DC \uD55C\uBC88
            \uB2F9\uC120\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
          <En>k__BackingField: 'Newron Trolph Jr. has won his eighth term,

            re-elected
            as the 67th President of the New United States.'
        When: 
        Effects: 
        Sync: wait
        SceneId: 
        Options: []
      - Seq: 3
        Type: say
        Actor: radio
        DialogueId: dlg_d1_elevator_003
        Arg: 
        Text:
          <Ko>k__BackingField: "\uD2B8\uB864\uD504 \uB300\uD1B5\uB839\uC740 \uB2F9\uC120
            \uC9C1\uD6C4 \uC5F0\uC124\uC5D0\uC11C"
          <En>k__BackingField: 'In his victory speech, President Trolph declared:'
        When: 
        Effects: 
        Sync: wait
        SceneId: 
        Options: []
      - Seq: 4
        Type: say
        Actor: radio
        DialogueId: dlg_d1_elevator_004
        Arg: 
        Text:
          <Ko>k__BackingField: "\"\uC704\uB300\uD55C \uAD6D\uAC00 \uC7AC\uAC74\uC740
            \uC544\uC9C1 \uB05D\uB098\uC9C0 \uC54A\uC558\uB2E4.\"\n\"\uC2E0\uBBF8\uD569\uC911\uAD6D\uC740
            \uB2E4\uC2DC \uD55C \uBC88 \uC138\uACC4\uC758 \uC911\uC2EC\uC5D0 \uC124
            \uAC83\uC774\uB2E4.\""
          <En>k__BackingField: '"The great national rebuilding is not over."

            "The
            New United States will stand at the center of the world once more."'
        When: 
        Effects: 
        Sync: wait
        SceneId: 
        Options: []
      - Seq: 5
        Type: say
        Actor: radio
        DialogueId: dlg_d1_elevator_005
        Arg: 
        Text:
          <Ko>k__BackingField: "\uB77C\uACE0 \uBC1D\uD614\uC2B5\uB2C8\uB2E4."
          <En>k__BackingField: "\u2014 he stated."
        When: 
        Effects: 
        Sync: wait
        SceneId: 
        Options: []
      Note: 
