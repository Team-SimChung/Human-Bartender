        Sync: wait
        SceneId: 
        Options: []
      - Seq: 11
        Type: say
        Actor: shiba
        DialogueId: dlg_np_shiba_1_011
        Arg: idle
        Text:
          <Ko>k__BackingField: "\uB531 \uBCF4\uBA74 \uC2DC\uBC14\uC796\uC544, \uC2DC\uBC14."
